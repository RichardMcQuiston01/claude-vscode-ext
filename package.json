{
  "name": "claude-settings-builder",
  "displayName": "Claude Settings Builder",
  "description": "GUI for building and editing Claude Code's .claude/settings.json files",
  "version": "0.0.1",
  "publisher": "richardmcquiston01",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeSettingsBuilder.open",
        "title": "Claude Settings Builder: Open"
      }
    ]
  },
  "scripts": {
    "postinstall": "npm install --prefix webview-ui",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p tsconfig.json",
    "build:webview": "npm run build --prefix webview-ui",
    "watch": "concurrently -n extension,webview -c blue,magenta \"npm:watch:extension\" \"npm:watch:webview\"",
    "watch:extension": "tsc -p tsconfig.json --watch",
    "watch:webview": "npm run dev --prefix webview-ui",
    "lint": "npm run lint:extension && npm run lint:webview",
    "lint:extension": "eslint \"src/**/*.ts\"",
    "lint:webview": "npm run lint --prefix webview-ui",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.134.0",
    "concurrently": "^10.0.5",
    "gts": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
